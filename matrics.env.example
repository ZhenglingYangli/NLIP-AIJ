# NLIP-AIJ / MatriCS 配置（Bash）
# 首次复制为 matrics.env；已预填的值核对后保留，两个 CHANGE_ME 数据路径需填写。
# 修改后执行 source matrics.env，再运行 "$AIJ_PYTHON" jobs/tools/configure_cluster.py。
# 首次升级先保留旧配置中的有效路径并备份 jobs/config.cluster.json，再生成新配置。

# 1. 站点模块（按需）
# 以下命令均已注释。先在终端查看模块，按实际名称替换 *_MODULE，再取消所需 load 行的注释。
# Python 需 3.12；新编译另需支持 C++17 的 GCC/G++、make/CMake、patch 和下列开发库。
# 已由系统或当前环境提供的项目保持注释；模块可能打包提供多个库，无需逐个加载。
# 查看本站可用模块：
# module avail python
# module avail gcc
# module avail cmake
# module avail gmp
# module avail mpfr
# module avail zlib
# 加载运行环境（PYTHON_312_MODULE 替换为实际 Python 3.12 模块名）：
# module load PYTHON_312_MODULE
# 加载编译环境（仅新编译时需要，替换为本站实际模块名）：
# module load GCC_MODULE
# module load CMAKE_MODULE
# module load GMP_MODULE
# module load MPFR_MODULE
# module load ZLIB_MODULE
# 加载后可在终端核对；Python 开发头文件通常随 Python 模块提供：
# python3 --version
# g++ --version
# command -v make cmake patch
# python3 -c 'import sysconfig; from pathlib import Path; p = Path(sysconfig.get_path("include")) / "Python.h"; print(p, p.is_file())'

# 2. 项目与 Python
# BOOTSTRAP 用于创建环境，AIJ_PYTHON 用于运行实验；复用其他环境时改其绝对路径。
# Python 包版本按 jobs/requirements.txt 和 sumup/requirements-analysis.txt。
export NLIP_PROJECT='/scratch/scherif/NLIP/AIJ/NLIP-Journal-Artifact-'
export NLIP_BOOTSTRAP_PYTHON='python3.12'
export AIJ_PYTHON="$NLIP_PROJECT/.venv-solvers/bin/python"
export PATH="${AIJ_PYTHON%/*}:$PATH"

# 3. 数据目录（前两项填写，MIPO 已预填）
# BENCHMARK_ROOT 下应有 qplib_fully_passed/（137 个）和 smt_0_10/（150 个）。
# DIVERSE_ROOT 放 108 个 CNF；MIPO_ROOT 放 870 个 JSON，原始 TXT 需先转换。
# 可复用旧 config.cluster.json 中的路径，文件名单见 benchmarks/manifests/。
export NLIP_BENCHMARK_ROOT='/CHANGE_ME/benchmarks'
export NLIP_DIVERSE_ROOT='/CHANGE_ME/diverse_sat'
export NLIP_MIPO_ROOT="$NLIP_PROJECT/benchmarks/mipo"

# 4. 外部求解器
# 已有同版本程序直接填原路径；缺少的装到此共享根目录，保留旧版本。bin/ 仅是默认位置。
# MaxHS：ASchidler/MaxHS b1e21b67cfe8ac2fd6b2dfb4b2b6b74eb3585740，SCIP 10.1.0 构建。
# WMaxCDCL：MSE2026 S6/SCIP；UWrMaxSAT：MSE2026 EXACT-W。已填学长提供的启动入口。
# 接入待办：NLIP 的竞赛脚本参数/工作目录适配及 S6 模式记录尚未完成，完成后再试跑。
# EvalMaxRes：MSE2026 EvalMaxSAT 与同包 nuwls；CaDiCaL：3.1.0。
# MaxHS、EvalMaxRes/nuwls 的实际安装路径仍需确认；unset 清除遗留的 UWrMaxSAT 参数。
export NLIP_SOFTWARE='/users/scherif/ComputeSpace/solvers'
export NLIP_MAXHS="$NLIP_SOFTWARE/bin/maxhs"
export NLIP_WMAXCDCL='/scratch/jzhang/SATSolvers/WMaxCDCL_MSE26/bin/run_EXACT-W_wmaxcdclS6'
export NLIP_UWRMAXSAT='/scratch/jzhang/SATSolvers/UWrMaxSAT_MSE26/bin/run_EXACT-W'
export NLIP_EVALMAXRES="$NLIP_SOFTWARE/bin/EvalMaxSAT"
export NLIP_EVALMAXRES_HELPER="$NLIP_SOFTWARE/bin/nuwls"
export NLIP_CADICAL='/scratch/jzhang/SATSolvers/Cadical/cadical-rel-3.1.0/build/cadical'
unset UWRFLAGS

# 5. SCIP
# SCIP 10.1.0 根目录须包含 include/scip/scip.h 和 lib/ 或 lib64/ 下的 libscip.so。
# 复用已有安装只改 SCIP_ROOT；PySCIPOpt 6.3.0 实际加载的 SCIP 也须为 10.1.0。
export SCIP_ROOT="$NLIP_SOFTWARE/scip"
if [[ -f "$SCIP_ROOT/lib/libscip.so" ]]; then
  export SCIP_LIBRARY_DIR="$SCIP_ROOT/lib"
else
  export SCIP_LIBRARY_DIR="$SCIP_ROOT/lib64"
fi

# 6. Gurobi 授权（按需）
# Gurobi 14.0.0 需计算节点可用的完整授权。已有站点授权直接沿用，文件授权则填写下行。
# export GRB_LICENSE_FILE='/CHANGE_ME/gurobi.lic'

# 7. 资源（默认保留）
# 每配置独占一节点，60 个单核实例并发、970G，单实例 16 GiB，最多同时运行 2 个配置。
# 同账户其他项目共享配额，必要时减少并发作业数；实例内部线程数保持为 1。
export NLIP_PARTITION=bigmem-amd
export NLIP_WORKERS=60
export NLIP_JOB_MEMORY_GIB=970
export NLIP_CONCURRENT_JOBS=2
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

# 配置生成后检查环境："$AIJ_PYTHON" jobs/tools/check_environment.py
# 正式前试跑："$AIJ_PYTHON" jobs/goSolver.py pilot（自动提交 Slurm，成功输出 TEST PASSED）。
