# NLIP-AIJ / MatriCS 本站配置，供 Bash 加载。
# 已预填：历史项目目录、MIPO 位置、共享软件根目录、固定版本及正式资源。
# 新安装的程序路径和实验 Python 路径已按约定布局填好，不代表本站已安装。
# 还需填写：NLIP_BENCHMARK_ROOT、NLIP_DIVERSE_ROOT 两个未知数据目录。
# 还需现场核对：Python 3.12 命令/模块、已有求解器实际位置、Gurobi 授权。
# 默认路径已存在且版本正确时直接保留，只改与本站实际情况不同的项。
#
# 在项目根目录操作。首次创建：test -e matrics.env || cp matrics.env.example matrics.env
# 编辑 matrics.env 后执行：source matrics.env
# 然后生成运行配置："$AIJ_PYTHON" jobs/tools/configure_cluster.py
# 本文件配置路径和资源，不自动下载软件或提交作业。
# 【填写】替换占位路径；【核对】现值正确则保留；【按需】只在本站需要时设置。
# matrics.env 和生成的 jobs/config.cluster.json 均不提交 Git。

# 1. 站点模块【按需】
# module load 用于将集群提供的软件加入当前环境，不是安装软件。
# 先在终端用 module avail python / module avail gcc 查看本站模块名。
# 只有依赖站点模块时，才在下面添加实际的 module load 命令。
# 系统已经提供所需软件则无需填写；不要把示意名称直接用于运行。
# 所需运行环境为 Python 3.12。新编译求解器还需要支持 C++17 的 GCC/G++、
# make、CMake、patch、GMP/MPFR/zlib 开发库及 Python 3.12 开发头文件。
# 例如本站实际列出了 python/3.12.x 时，可填写 module load python/3.12.x；
# 其中 x 必须替换成本站列出的版本号。数学开发库也按实际模块名加载。
# 在此填写本站需要的 module load 命令：

# 2. 项目与 Python【核对】
# 已按历史记录填好 checkout，登录节点和计算节点均须能访问。
export NLIP_PROJECT='/scratch/scherif/NLIP/AIJ/NLIP-Journal-Artifact-'
# 用于创建环境的 Python 3.12 命令或绝对路径，先运行其 --version 核对。
export NLIP_BOOTSTRAP_PYTHON='python3.12'
# 实验实际使用的 Python。复用同版本环境时可改为该环境的解释器绝对路径。
# 依赖版本由 jobs/requirements.txt、sumup/requirements-analysis.txt 固定。
export AIJ_PYTHON="$NLIP_PROJECT/.venv-solvers/bin/python"
export PATH="${AIJ_PYTHON%/*}:$PATH"

# 3. 数据目录【前两项填写，MIPO 已预填】
# 可从旧 jobs/config.cluster.json 读取有效数据路径，数据无需搬到项目内。
# 本目录下面须有 qplib_fully_passed/（137 个 QPLIB）和 smt_0_10/（150 个 SMT）。
export NLIP_BENCHMARK_ROOT='/CHANGE_ME/benchmarks'
# 108 个 DiverseSAT CNF 的目录；实验 k=2 已在配置中固定。
export NLIP_DIVERSE_ROOT='/CHANGE_ME/diverse_sat'
# 870 个 MIPO JSON 的目录。下面是历史位置，实际文件已在此处则直接复用。
# 若只有 integer/txtfiles/ 原始 TXT，先用 jobs/data/convert_mipo.py 转成 JSON。
# 四类文件名以 benchmarks/manifests/ 的清单为准，配置工具会检查是否齐全。
export NLIP_MIPO_ROOT="$NLIP_PROJECT/benchmarks/mipo"

# 4. 外部求解器【核对版本及路径】
# 软件根目录就是这一层。新软件也装在这里，bin/ 仅用于集中放可执行文件。
# 已有符合下列版本和构建要求的程序直接复用，分别填写原绝对路径。
# 不要求移动到 bin/，也不重复安装。版本不符时保留旧程序，另选新文件名。
export NLIP_SOFTWARE='/users/scherif/ComputeSpace/solvers'

# MaxHS：ASchidler/MaxHS 提交 b1e21b67cfe8ac2fd6b2dfb4b2b6b74eb3585740，SCIP 10.1.0 构建。
export NLIP_MAXHS="$NLIP_SOFTWARE/bin/maxhs"
# WMaxCDCL：MSE2026 WMaxCDCL2026 的独立 wmaxcdcl_static，不选 _scip 组合版本。
export NLIP_WMAXCDCL="$NLIP_SOFTWARE/bin/wmaxcdcl_static"
# UWrMaxSAT：2.0.6，包含本轮要求的 MaxPre 和 SCIP 10.1.0 支持。
export NLIP_UWRMAXSAT="$NLIP_SOFTWARE/bin/uwrmaxsat"
# EvalMaxRes：MSE2026 发行包，程序名为 EvalMaxSAT；nuwls 使用同包配套文件。
export NLIP_EVALMAXRES="$NLIP_SOFTWARE/bin/EvalMaxSAT"
export NLIP_EVALMAXRES_HELPER="$NLIP_SOFTWARE/bin/nuwls"
# 独立 SAT 后端：CaDiCaL 3.1.0，可用 "$NLIP_CADICAL" --version 核对。
export NLIP_CADICAL="$NLIP_SOFTWARE/bin/cadical"
# 正式启动参数由配置工具和求解接口提供，此处只填写程序路径。
# 清除可能由其他实验设置的 UWrMaxSAT 隐式附加参数。
unset UWRFLAGS

# 5. SCIP 安装【核对】
# SCIP 10.1.0 的安装根目录，须包含 include/scip/scip.h 和 lib*/libscip.so。
# MaxHS、UWrMaxSAT 和 PySCIPOpt 需要它的头文件或库，因此保留完整目录。
# 复用站点安装时只修改 SCIP_ROOT；下方自动选择常见的 lib 或 lib64 布局。
# PySCIPOpt 6.3.0 实际加载的 SCIP 也须为 10.1.0，由环境检查程序核对。
export SCIP_ROOT="$NLIP_SOFTWARE/scip"
if [[ -f "$SCIP_ROOT/lib/libscip.so" ]]; then
  export SCIP_LIBRARY_DIR="$SCIP_ROOT/lib"
else
  export SCIP_LIBRARY_DIR="$SCIP_ROOT/lib64"
fi

# 6. Gurobi 授权【按需，与 SCIP 无关】
# Gurobi 14.0.0 需要计算节点可用的完整授权，仅安装 gurobipy 不代表已有授权。
# 本站模块或许可证服务已提供授权时沿用现状；文件授权则取消下一行注释并填写。
# export GRB_LICENSE_FILE='/CHANGE_ME/gurobi.lic'

# 7. 正式实验资源【默认保留，调整须符合账户额度】
# 每个配置作业独占一个节点，申请 60 CPU / 970G，最多同时运行两个配置作业。
# 60 个单核实例并发，单实例 16 GiB；该预算由 jobs/config.json 固定。
# 同一 MatriCS 账户运行其他项目时共享配额，应相应减少同时运行的作业数。
export NLIP_PARTITION=bigmem-amd
export NLIP_WORKERS=60
export NLIP_JOB_MEMORY_GIB=970
export NLIP_CONCURRENT_JOBS=2
# 每个实例内部保持单线程。
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

# 8. 修改后的操作（在项目目录执行，以下是命令说明，不会自动执行）
# source matrics.env
# "$AIJ_PYTHON" jobs/tools/configure_cluster.py
# 路径配置成功应显示 runs: 22220；这一步不启动求解。
# 环境依赖检查："$AIJ_PYTHON" jobs/tools/check_environment.py
# 正式前试跑："$AIJ_PYTHON" jobs/goSolver.py pilot
# pilot 自动提交 Slurm 作业，覆盖 60 个配置组合，通过时输出 TEST PASSED。
# 首次从旧配置升级时，先记录有效路径并备份旧 jobs/config.cluster.json，
# 再生成新配置，以采用本轮默认参数。日常改路径后重新生成配置即可。
